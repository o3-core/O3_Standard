  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lab Value Units</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The units of measure for the lab value </rdfs:comment>
