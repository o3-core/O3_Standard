  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metastatic-Mediastinum {O3_0060050_00017}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distant-None {O3_0060050_00008}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nodal-Distant {O3_0060050_00007}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Primary - Seminal Vesicles {O3_0060050_00003}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distant-CHAARTED-High Volume {O3_0060050_00010}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nodal-None {O3_0060050_00004}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Primary - Prostate {O3_0060050_00002}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distant- CHAARTED-Low Volume {O3_0060050_00009}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metastatic-Viscera {O3_0060050_00012}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nodal-Pelvic {O3_0060050_00005}</StandardValuesList>
