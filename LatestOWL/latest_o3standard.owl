  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Text description of findings from biopsy performed as part of interventional procedure. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InterventionalProcedure_BiopsyStatus</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0400100</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Highly Desirable</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">String</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

<owl:Class rdf:about="InterventionalProcedure_IsPreIrradiation">
  <rdfs:subClassOf rdf:resource="InterventionalProcedure"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is PreIrradiation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Was intervention performed prior to radiation therapy. Must be completed for TURP. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InterventionalProcedure_IsPreIrradiation</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0400110</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Required</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Boolean</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes, except when intervention is TURP</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

<owl:Class rdf:about="InterventionalProcedure_PatientHelperBrought">
  <rdfs:subClassOf rdf:resource="InterventionalProcedure"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient Helper Brought</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This records if a patient needs to routinely bring a helper with them for the procedure. There may be a wide range of reasons including but not limited to transportation, disability, physical or emotional support. The simple Boolean indicator is a high level SDOH measure, with minimal burden for charting , flagging if the patient has additional challenges for receiving care. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InterventionalProcedure_PatientHelperBrought</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0400120</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optional</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Boolean</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

<owl:Class rdf:about="InterventionalProcedure_ResidenceDuringTreatment">
  <rdfs:subClassOf rdf:resource="InterventionalProcedure"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Residence During Treatment</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">During treatment, patients may stay at a location different from their primary residence to be nearer to the care center. Cost for staying at the other location may be subsidized </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InterventionalProcedure_ResidenceDuringTreatment</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0400130</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optional</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Boolean</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Other Location Subsidized {O3_0400130_00003}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Primary Residence {O3_0400130_00001}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Other Location {O3_0400130_00002}</StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Primary Residence</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

