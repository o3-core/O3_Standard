  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indication of presence of neoplastic tissue within the margin of tissue proximal to the </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
