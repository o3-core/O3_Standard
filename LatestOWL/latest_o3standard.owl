<owl:Class rdf:about="PatientTreatmentOutcome_RecurrenceInVOutField">
  <rdfs:subClassOf rdf:resource="PatientTreatmentOutcome"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recurrence In Field vs Out of field</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If there is a recurrence, then indicate the location of the recurrence with respect to the radiation dose surrogates (PTV, Nodal, etc) or relative to the dose distribution </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PatientTreatmentOutcome_RecurrenceInVOutField</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0060060</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Desirable</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">String</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infield-Nodal {O3_0060060_00002}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infield-Central High Dose Failure {O3_0060060_00003}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infield-PTV {O3_0060060_00001}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Out of Field {O3_0060060_00007}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infield-Extraneous Dose Failure {O3_0060060_00006}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infield-Peripheral High Dose Failure {O3_0060060_00004}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infield-Central Elective Dose Failure {O3_0060060_00005}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reference Systems for Values: Abdallah et al. Radiation Oncology 2016 Radiat Oncol. 2016 Jul 26;11(1):95. doi: 10.1186/s13014-016-0678-7. PMID: 27460585; PMCID: PMC4962405. {O3_0060060_00008}</StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extraneous Dose Failure</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reference Systems for Values: Abdallah et al. Radiation Oncology 2016 Radiat Oncol. 2016 Jul 26;11(1):95. doi: 10.1186/s13014-016-0678-7. PMID: 27460585; PMCID: PMC4962405.</rdfs:isDefinedBy>
</owl:Class>

