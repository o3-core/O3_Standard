  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The energy spectrum reference used to characterize radiation delivered. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTTreatedPlanDetailsXRT_Energy</StringCode>
