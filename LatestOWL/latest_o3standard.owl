<owl:Class rdf:about="RTTreatedPlan_UsedHeterogeneityCorrection">
  <rdfs:subClassOf rdf:resource="RTTreatedPlan"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UsedHeterogeneityCorrection</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Were differences in the tissue densities, as reflected in HU values, used in the dose calculation to account for impact on treatment beams? </rdfs:comment>
