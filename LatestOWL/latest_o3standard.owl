  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsDesirable"/>
      <owl:onClass rdf:resource="DiagStagingProst_TertiaryGleasonScoreAtBiopsy"/>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
