<owl:Class rdf:about="RTTreatedPlan_DoseExpressedToMaterial">
  <rdfs:subClassOf rdf:resource="RTTreatedPlan"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAPM/ASTRO BDSC list initially, then value set adopted in CodeX if acceptable</rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dose Expressed To Material</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Treatment devices and treatment planning systems may be calibrated so that the numerical values of dose (energy per unit mass) delivered corresponds to either water or muscle. Water is the most typical. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTTreatedPlan_DoseExpressedToMaterial</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0190120</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Highly Desirable</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">String</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAPM/ASTRO BDSC list initially, then value set adopted in CodeX if acceptable</StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Water {O3_0190120_00001}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Muscle {O3_0190120_00002}</StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAPM/ASTRO BDSC list initially, then value set adopted in CodeX if acceptable</ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Water</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

