  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Primary- None {O3_0060050_00001}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metastatic-Liver {O3_0060050_00016}</StandardValuesList>
