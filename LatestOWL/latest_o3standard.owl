<owl:Class rdf:about="LabResult_Value">
  <rdfs:subClassOf rdf:resource="LabResult"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lab Value</rdfs:label>
