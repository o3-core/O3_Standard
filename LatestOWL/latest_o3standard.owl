  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Other Location {O3_0350110_00002}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Primary Residence {O3_0350110_00001}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Other Location Subsidized {O3_0350110_00003}</StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ReferenceSystemForValues>
