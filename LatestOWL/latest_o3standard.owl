<owl:Class rdf:about="InterventionalProcedure_Intent">
  <rdfs:subClassOf rdf:resource="InterventionalProcedure"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interventional Intent</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physician intent animating decision for intervention. </rdfs:comment>
