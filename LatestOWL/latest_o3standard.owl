  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Revision</rdfs:label>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0190090_00003</NumericCode>
</owl:Class>

<owl:Class rdf:about="RTTreatedPlan_ReasonForAdaptationOrRevision">
  <rdfs:subClassOf rdf:resource="RTTreatedPlan"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:isDefinedBy>
