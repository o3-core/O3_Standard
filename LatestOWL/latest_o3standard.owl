  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0320030</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optional</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">String</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(+Other) {O3_0320030_00003}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Testosterone {O3_0320030_00002; SCTID- 104957004;NCITC- C2299;NCIMT- CL026906}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSA {O3_0320030_00001; SCTID- 63476009_;NCITC- C17634; NCIMT- C0201544}</StandardValuesList>
