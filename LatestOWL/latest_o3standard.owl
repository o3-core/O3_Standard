<owl:Class rdf:about="DiagStagingProst">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsRequired-PHI"/>
      <owl:onClass rdf:resource="DiagStagingProst_DateOfRecord"/>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsRequired."/>
      <owl:onClass rdf:resource="DiagStagingProst_AgeAtRecord"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsRequired"/>
      <owl:onClass rdf:resource="DiagStagingProst_HadProstatectomy"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsRequired"/>
      <owl:onClass rdf:resource="DiagStagingProst_ProstatectomyMarginStatus"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsDesirable"/>
      <owl:onClass rdf:resource="DiagStagingProst_ProstateVolume"/>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsOptional"/>
      <owl:allValuesFrom rdf:resource="DiagStagingProst_ImagingForStagingT"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsOptional"/>
      <owl:allValuesFrom rdf:resource="DiagStagingProst_ImagingForStagingN"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsOptional"/>
      <owl:allValuesFrom rdf:resource="DiagStagingProst_ImagingforStagingM"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
