  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTPlanning Structure</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An item that is labeled and segmented on an image data set for use in radiotherapy treatment planning. </rdfs:comment>
