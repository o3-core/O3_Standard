  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Current Smoker (Individuals who have smoked 100 cigarettes in their lifetime and currently smoke cigarettes every day (daily) or some days (nondaily)). {O3_0020280_00004}</StandardValuesList>
