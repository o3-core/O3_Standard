  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Systemic Therapy Course Facility Address</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Address of the facility where the course of systemic therapy was delivered. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
