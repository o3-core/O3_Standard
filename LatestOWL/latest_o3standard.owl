  <rdfs:subClassOf rdf:resource="ReirradiationEvaluation_RegistrationBasis"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deformable Registration</rdfs:label>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0210100_00002</NumericCode>
</owl:Class>

