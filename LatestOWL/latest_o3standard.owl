  <rdfs:subClassOf rdf:resource="InterventionalProcedure_DistanceToPatientPrimaryResidenceDrivingUnits"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Miles</rdfs:label>
