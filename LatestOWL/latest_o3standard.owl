    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Treatment Plan Quality Assurance Measurement</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sets of quality assurance (QA) measurements are carried out for several types of radiation therapy plans (e.g. IMRT, VMAT). There is not uniform agreement on the exact measurements or details to be performed, reference values for comparison and tolerance levels, etc.. This element provides a generalized framework for capturing details of individual QA measurements to include with other data describing patient treatments. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Key Element</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTTreatedPlanQAMeasurement</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0620000</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Highly Desirable</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <IsLongitudinalKeyElement rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</IsLongitudinalKeyElement>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

