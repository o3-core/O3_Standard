<owl:Class rdf:about="ProviderReportedToxicity_ToxicityMeasure">
  <rdfs:subClassOf rdf:resource="ProviderReportedToxicity"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Moreno et. al. publication on use of Delphi process</rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Toxicity Measure</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Name in the coding system selected for the provider evaluated toxicity reported. Priority 1 values are recommended for evaluation at baseline, at least once during treatment course, at end of course and as part of each follow up visit. Other values may be included, the list defines the high priority recommendations. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ProviderReportedToxicity_ToxicityMeasure</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0070040</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Required</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">String</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Moreno et. al. publication on use of Delphi process</StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fecal Incontinence (Priority 1) {O3_0070040_00013}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Urinary Incontinence (Priority 1) {O3_0070040_00003; SCTID- 165232002 ;NCITC- C146786 ; NCIMT - C4230731}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rectal Hemorrhage (Priority 1) {O3_0070040_00002; SCTID-; 12063002 NCITC- C56560; NCIMT-C1962965}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rectal Stenosis (Priority 2) {O3_0070040_00023}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Urinary Tract Pain (Priority 2) {O3_0070040_00020}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Urinary Retention (Priority 1) {O3_0070040_00004; SCTID-267064002; }</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gynecomastia (Priority 2) {O3_0070040_00031}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cystitis Noninfective (Priority 2) {O3_0070040_00019}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hematuria (Priority 1) {O3_0070040_00006; SCTID-34436003; }</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Urinary Urgency (Priority 1) {O3_0070040_00009}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bladder Spasms (Priority 2) {O3_0070040_00021}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Depression (Priority 2) {O3_0070040_00028}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hemorrhoids (Priority 2) {O3_0070040_00026}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No toxicity assessment {O3_0070040_00001}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rectal Fistula (Priority 1) {O3_0070040_00008}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ejaculation Disorder (Priority 2) {O3_0070040_00029}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hot flashes (Priority 2) {O3_0070040_00022}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fatigue (Priority 2) {O3_0070040_00024}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(+ Other) {O3_0070040_00032}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rectal Pain (Priority 2) {O3_0070040_00018}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diarrhea (Priority 1) {O3_0070040_00015}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rectal Mucositis (Priority 2) {O3_0070040_00025}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Urinary Frequency (Priority 1) {O3_0070040_00010}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dysuria (Priority 1) {O3_0070040_00007}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Erectile Disfunction (Priority 1) {O3_0070040_00005; SCTID-860914002; }</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rectal Fissure (Priority 2) {O3_0070040_00027}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rectal Perforation (Priority 1) {O3_0070040_00014}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Urinary Tract Obstruction (Priority 2) {O3_0070040_00017}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Urinary Fistula (Priority 1) {O3_0070040_00011}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rectal Ulcer (Priority 1) {O3_0070040_00016}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Proctitis (Priority 1) {O3_0070040_00012}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Libido Decrease (Priority 2) {O3_0070040_00030}</StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Moreno et. al. publication on use of Delphi process</ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rectal Hemorrhage</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C53781</NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1879645</NCIMT>
</owl:Class>

