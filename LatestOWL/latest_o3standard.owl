  <rdfs:subClassOf rdf:resource="DiagStagingMeasurement_KeyElement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DiagStaging</rdfs:label>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0570030_00001</NumericCode>
