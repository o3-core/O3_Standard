  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAPM/ASTRO BDSC list initially, then value set adopted in CodeX if acceptable</StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radiofrequency {O3_0190240_00003; SCTID- 469172007 ; NCITC- _ ; NCIMT- _ }</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None {O3_0190240_00001}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gold Seed {O3_0190240_00002}</StandardValuesList>
