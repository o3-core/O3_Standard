  <rdfs:subClassOf rdf:resource="ReirradiationEvaluation_RegistrationBasis"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Point Dose Estimate</rdfs:label>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0210100_00003</NumericCode>
