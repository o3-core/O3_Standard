<owl:Class rdf:about="PerformanceScore_Value">
  <rdfs:subClassOf rdf:resource="PerformanceScore"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://ecog-acrin.org/resources/ecog-performance-status
 Definition of Karnofsky Performance Status - NCI Dictionary of Cancer Terms - National Cancer Institute
 Oken, M.M., Creech, R.H., Tormey, D.C., Horton, J., Davis, T.E., McFadden, E.T., Carbone, P.P.: Toxicity And Response Criteria Of The Eastern Cooperative Oncology Group. Am J Clin Oncol 5:649-655, 1982.
 Schag CC, Heinrich RL, Ganz PA. Karnofsky performance status revisited: reliability, validity, and guidelines. J Clin Oncol. 1984 Mar;2(3):187-93. doi: 10.1200/JCO.1984.2.3.187. PMID: 6699671.
 Karnofsky DA, Burchenal JH: The clinical evaluation of chemotherapeutic agents in cancer, in Macleod CM (ed): Evaluation
 of Chemotherapeutic Agents. New York, Columbia University Press, 1949 p 199-205.
 </rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Performance Score Value</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karnofsky = 0-100 (list 100 first since it is good performance and most common); ECOG =0-5 (list 0 first since it is good performance and most common) </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PerformanceScore_Value</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0090040</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Required</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">String</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karnofsky = 0-100 (list 100 first since it is good performance and most common); ECOG =0-5 (list 0 first since it is good performance and most common)</StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://ecog-acrin.org/resources/ecog-performance-status
 Definition of Karnofsky Performance Status - NCI Dictionary of Cancer Terms - National Cancer Institute
 Oken, M.M., Creech, R.H., Tormey, D.C., Horton, J., Davis, T.E., McFadden, E.T., Carbone, P.P.: Toxicity And Response Criteria Of The Eastern Cooperative Oncology Group. Am J Clin Oncol 5:649-655, 1982.
 Schag CC, Heinrich RL, Ganz PA. Karnofsky performance status revisited: reliability, validity, and guidelines. J Clin Oncol. 1984 Mar;2(3):187-93. doi: 10.1200/JCO.1984.2.3.187. PMID: 6699671.
 Karnofsky DA, Burchenal JH: The clinical evaluation of chemotherapeutic agents in cancer, in Macleod CM (ed): Evaluation
 of Chemotherapeutic Agents. New York, Columbia University Press, 1949 p 199-205.
 </ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">90</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

