<owl:Class rdf:about="RTCourse_DistanceToPatientPrimaryResidenceDriving">
  <rdfs:subClassOf rdf:resource="RTCourse"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distance To Patient Primary Residence Driving</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Driving distance from the patient’s primary residence to the facility where the radiation therapy course is delivered. Provides a PHI neutral measure of accessibility. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTCourse_DistanceToPatientPrimaryResidenceDriving</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0100170</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optional</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Numeric</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reference Systems for Values: There are several applications which may be used to calculate driving distance between locations. References for determining Methods for Calculating travel distance AHRQ https://hcup-us.ahrq.gov/reports/methods/MS2021-02-Distance-to-Hospital.jsp#t1 , https://ij-healthgeographics.biomedcentral.com/articles/10.1186/1476-072X-7-63 {O3_0100170_00001}</StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">45.6</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reference Systems for Values: There are several applications which may be used to calculate driving distance between locations. References for determining Methods for Calculating travel distance AHRQ https://hcup-us.ahrq.gov/reports/methods/MS2021-02-Distance-to-Hospital.jsp#t1 , https://ij-healthgeographics.biomedcentral.com/articles/10.1186/1476-072X-7-63</rdfs:isDefinedBy>
</owl:Class>

<owl:Class rdf:about="Null_RTCourse_DistanceToPatientPrimaryResidenceDriving">
  <rdfs:subClassOf rdf:resource="RTCourse_DistanceToPatientPrimaryResidenceDriving"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Null</rdfs:label>
</owl:Class>

<owl:Class rdf:about="RTCourse_DistanceToPatientPrimaryResidenceDrivingMethod">
  <rdfs:subClassOf rdf:resource="RTCourse"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distance To Patient Primary Residence Driving Method</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reference (e.g. URL for product, publication citation) for method used to calculate the driving distance. Driving distance is more specific than direct distance and should be calculated based on address or GPS. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTCourse_DistanceToPatientPrimaryResidenceDrivingMethod</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0100180</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optional</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">String</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

<owl:Class rdf:about="RTCourse_DistanceToPatientPrimaryResidenceDrivingUnits">
  <rdfs:subClassOf rdf:resource="RTCourse"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distance To Patient Primary Residence Driving Units</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Units for driving distance from the patient’s primary residence to the facility where the radiation therapy course is delivered. Direct distance may be less than or driving distance. Provides a PHI neutral measure of accessibility. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTCourse_DistanceToPatientPrimaryResidenceDrivingUnits</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0100190</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optional</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Numeric</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kilometers {O3_0100190_00002}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Miles {O3_0100190_00001}</StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Miles</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

<owl:Class rdf:about="MilesRTCourse_DistanceToPatientPrimaryResidenceDrivingUnits">
  <rdfs:subClassOf rdf:resource="RTCourse_DistanceToPatientPrimaryResidenceDrivingUnits"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Miles</rdfs:label>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0100190_00001</NumericCode>
</owl:Class>

<owl:Class rdf:about="KilometersRTCourse_DistanceToPatientPrimaryResidenceDrivingUnits">
  <rdfs:subClassOf rdf:resource="RTCourse_DistanceToPatientPrimaryResidenceDrivingUnits"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kilometers</rdfs:label>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0100190_00002</NumericCode>
</owl:Class>

<owl:Class rdf:about="Null_RTCourse_DistanceToPatientPrimaryResidenceDrivingUnits">
  <rdfs:subClassOf rdf:resource="RTCourse_DistanceToPatientPrimaryResidenceDrivingUnits"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Null</rdfs:label>
</owl:Class>

<owl:Class rdf:about="RTCourseTargetDose">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsRequired"/>
      <owl:onClass rdf:resource="RTCourseTargetDose_VolumeName"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsRequired"/>
      <owl:onClass rdf:resource="RTCourseTargetDose_VolumeDose"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsRequired"/>
      <owl:onClass rdf:resource="RTCourseTargetDose_DoseUnit"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsChildElement-Of"/>
      <owl:onClass rdf:resource="RTCourse"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radiation Therapy Course - Target Dose</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Identify targets and overall doses treated with the radiation therapy course. This supports systematic reporting what was done for treatment summaries. For example it enables identifying that the prostate received a dose of 7200 cGy. Where the prescription reflects intent, this element reflects what was delivered. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Key Element</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTCourseTargetDose</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0110000</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Highly Desirable</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</MoreThanOneValueAllowed>
  <IsLongitudinalKeyElement rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</IsLongitudinalKeyElement>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

<owl:Class rdf:about="RTCourseTargetDose_VolumeName">
  <rdfs:subClassOf rdf:resource="RTCourseTargetDose"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Target Volumes are defined in HL7-FHIR mCode</rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Target Volume</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Name of target volume structure. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTCourseTargetDose_VolumeName</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0110010</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Required</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">String</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAPM/ASTRO BDSC list applied in CodeX</StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Target Volumes are defined in HL7-FHIR mCode</ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prostate</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

<owl:Class rdf:about="RTCourseTargetDose_VolumeDose">
  <rdfs:subClassOf rdf:resource="RTCourseTargetDose"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Target Volumes are defined in HL7-FHIR mCode</rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Target Volume Dose</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dose delivered to the target volume in fulfilling the prescription </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTCourseTargetDose_VolumeDose</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0110020</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Required</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Decimal</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAPM/ASTRO BDSC list applied in CodeX</StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Target Volumes are defined in HL7-FHIR mCode</ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">7200 cGy</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

<owl:Class rdf:about="RTCourseTargetDose_DoseUnit">
  <rdfs:subClassOf rdf:resource="RTCourseTargetDose"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dose Unit</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unit corresponding to numerical value of dose </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTCourseTargetDose_DoseUnit</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0110030</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Required</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">String</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cGy {O3_0110030_00001}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CGE {O3_0110030_00003}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RBE {O3_0110030_00004}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gy {O3_0110030_00002}</StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cGy</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

<owl:Class rdf:about="cGy">
  <rdfs:subClassOf rdf:resource="RTCourseTargetDose_DoseUnit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cGy</rdfs:label>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0110030_00001</NumericCode>
</owl:Class>

<owl:Class rdf:about="Gy">
  <rdfs:subClassOf rdf:resource="RTCourseTargetDose_DoseUnit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gy</rdfs:label>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0110030_00002</NumericCode>
</owl:Class>

<owl:Class rdf:about="CGE">
  <rdfs:subClassOf rdf:resource="RTCourseTargetDose_DoseUnit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CGE</rdfs:label>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0110030_00003</NumericCode>
</owl:Class>

<owl:Class rdf:about="RBE">
  <rdfs:subClassOf rdf:resource="RTCourseTargetDose_DoseUnit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RBE</rdfs:label>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0110030_00004</NumericCode>
</owl:Class>

<owl:Class rdf:about="RTCourseEvent">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsRequired-PHI"/>
      <owl:onClass rdf:resource="RTCourseEvent_DateOfRecord"/>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsRequired."/>
      <owl:onClass rdf:resource="RTCourseEvent_AgeAtRecord"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsHighlyDesirable"/>
      <owl:allValuesFrom rdf:resource="RTCourseEvent_Type"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsChildElement-Of"/>
      <owl:onClass rdf:resource="RTCourse"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radiation Therapy Course - Event</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Note worthy events occurring during the radiation therapy treatment course. All instances record the Patient Age and/or the Date at the time of the Radiation Therapy Course Event value. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Key Element</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTCourseEvent</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0120000</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Desirable</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</MoreThanOneValueAllowed>
  <IsLongitudinalKeyElement rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsLongitudinalKeyElement>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

<owl:Class rdf:about="RTCourseEvent_DateOfRecord">
  <rdfs:subClassOf rdf:resource="RTCourseEvent"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISO 8601</rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DateOfRecord</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Date/Time associated with this instance of Radiation Therapy Course - Event. Formatted String  yyyy-MM-ddTHH:mm:ss+05:00  using ISO8601 with time zone. The Description of the Key Element specifies which time point to use for the record.Required For systems allowing PHI. Optional in systems not allowing PHI</rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Longitudinal Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTCourseEvent_DateOfRecord</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0120010</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Required-PHI</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">String</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None Specified</StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISO 8601</ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No for systems alloing PHI. Yes for systems not allowing PHI</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-01-01T15:32:00+05:00</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

<owl:Class rdf:about="RTCourseEvent_AgeAtRecord">
  <rdfs:subClassOf rdf:resource="RTCourseEvent"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None Specified</rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AgeAtRecord</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Age of the patient at the time associated with this instance of Radiation Therapy Course - Event. This is calculated to 7 decimal places with respect to DateOfBirth, so that differences in time between events can be resolved to the second. Age is not a PHI restricted element for patients younger than 89. The Description of the Key Element specifies which time to use for the record in calculating age. Required for systems not allowing PHI. Highly Desirable in systems allowing PHI to simplify analysis </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Longitudinal Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTCourseEvent_AgeAtRecord</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0120020</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Required.</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Decimal</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None Specified</StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None Specified</ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes for systems allowing PHI. No for systems not allowing PHI</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">59.1234567 or 78.0000000</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

<owl:Class rdf:about="RTCourseEvent_Type">
  <rdfs:subClassOf rdf:resource="RTCourseEvent"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SNOMED will need to request additional codes</rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Course Event Type</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Events resulting in altering the change in approach for the radiation therapy course. This excludes events captured in the Encounters key element, such as emergency room visits or hospitalizations.</rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTCourseEvent_Type</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0120030</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Highly Desirable</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">String</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Need</StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Treatment Missed -Patient cannot secure time away from work {O3_0120030_00013; }</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Simulation_Diagnostic_CT {O3_0120030_00022; }</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refusal of treatment by patient {O3_0120030_00001; SCTID-105480006}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lost to Follow-up {O3_0120030_00007; SCTID-399307001}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient Transferred to Different Institution {O3_0120030_00016; SCTID-107724000}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Simulation_Diagnositic_SPECT {O3_0120030_00025; }</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Financial Problem {O3_0120030_00002; SCTID-16093205}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Treatment Completed {O3_0120030_00003; SCTID-182992009}</StandardValuesList>
