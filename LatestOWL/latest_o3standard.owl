<owl:Class rdf:about="HCO_SiteStaff_TimePointValue">
  <rdfs:subClassOf rdf:resource="HCO_SiteStaff"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None</rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Summary Time Point Value</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Value use for reference to time point type. For example if Time Point Type was Last Fiscal Year, then Time Point Value set to 2023 would specify the year a values in the record.</rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
