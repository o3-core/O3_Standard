  <rdfs:subClassOf rdf:resource="HCO_SiteCount_TimePointType"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(+) Other</rdfs:label>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0490030_00003</NumericCode>
</owl:Class>

<owl:Class rdf:about="HCO_SiteCount_TimePointValue">
  <rdfs:subClassOf rdf:resource="HCO_SiteCount"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None</rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Site Counts Time Point Value</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Value use for reference to time point type. For example if Time Point Type was Last Fiscal Year, then Time Point Value set to 2023 would specify the year a values in the record.</rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HCO_SiteCount_TimePointValue</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0490040</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Highly Desirable</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
