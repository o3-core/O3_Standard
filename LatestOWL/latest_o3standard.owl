<owl:Class rdf:about="PatientEncounter_PatientLanguageUsed">
  <rdfs:subClassOf rdf:resource="PatientEncounter"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.loc.gov/standards/iso639-2/php/code_list.php
 </rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient Language Used in Encounter</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The language used by the patient during the encounter. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PatientEncounter_PatientLanguageUsed</StringCode>
