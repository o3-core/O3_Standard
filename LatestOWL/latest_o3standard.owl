<owl:Class rdf:about="GenomicsMarker_Zygosity">
  <rdfs:subClassOf rdf:resource="GenomicsMarker"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zygosity</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zygosity is the genetic state of an individual at a specific gene locus, describing whether the two alleles (copies) of that gene are identical (homozygous) or different (heterozygous) </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GenomicsMarker_Zygosity</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0650060</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Desirable</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">String</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(+ Other) {O3_0650060_00007}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Homozygous Dominant {O3_0650060_00002}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heterozygous {O3_0650060_00004}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hemizygous {O3_0650060_00005}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nullizygous {O3_0650060_00006}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Homozygous {O3_0650060_00001}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Homozygous Recessive {O3_0650060_00003}</StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

