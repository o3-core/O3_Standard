  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">String</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Format string as ‘X’ for photons or ‘E’ for electrons, followed by a 2 digit number for energy. Append with ‘FFF’ if flattening filter free is used.</StandardValuesUse>
