<owl:Class rdf:about="DiagStagingLung">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsRequired-PHI"/>
      <owl:onClass rdf:resource="DiagStagingLung_DateOfRecord"/>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsRequired."/>
      <owl:onClass rdf:resource="DiagStagingLung_AgeAtRecord"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsDesirable"/>
      <owl:allValuesFrom rdf:resource="DiagStagingLung_Operability"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsDesirable"/>
      <owl:allValuesFrom rdf:resource="DiagStagingLung_PrimaryLocations"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsDesirable"/>
      <owl:allValuesFrom rdf:resource="DiagStagingLung_InvasionSite"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsDesirable"/>
      <owl:allValuesFrom rdf:resource="DiagStagingLung_NodalSite"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsDesirable"/>
      <owl:allValuesFrom rdf:resource="DiagStagingLung_NodalSiteSampleMethod"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="IsDesirable"/>
      <owl:allValuesFrom rdf:resource="DiagStagingLung_MetastaticSite"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diagnosis and Staging - Lung Components</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Additional diagnosis and staging information, specific for lung cancer, used to guide the treatment. This is stored as a longitudinal attribute with the DateTime and PatientAge corresponding to the time of diagnosis. All instances record the Patient Age and/or the Date at the time of assigning the diagnosis and staging. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Key Element</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DiagStagingLung</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0590000</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Required</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</MoreThanOneValueAllowed>
  <IsLongitudinalKeyElement rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</IsLongitudinalKeyElement>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

<owl:Class rdf:about="DiagStagingLung_DateOfRecord">
  <rdfs:subClassOf rdf:resource="DiagStagingLung"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISO 8601</rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DateOfRecord</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Date/Time associated with this instance of Diagnosis and Staging - Lung Components. Formatted String  yyyy-MM-ddTHH:mm:ss+05:00  using ISO8601 with time zone. The Description of the Key Element specifies which time point to use for the record.Required For systems allowing PHI. Optional in systems not allowing PHI</rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Longitudinal Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DiagStagingLung_DateOfRecord</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0590010</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Required-PHI</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">String</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">None Specified</StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISO 8601</ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No for systems alloing PHI. Yes for systems not allowing PHI</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-01-01T15:32:00+05:00</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
