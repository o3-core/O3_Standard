<owl:Class rdf:about="RTCourse_PatientHelperBrought">
  <rdfs:subClassOf rdf:resource="RTCourse"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient Helper Brought</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This records if a patient needs to routinely bring a helper with them for treatments in the RT Course. There may be a wide range of reasons including but not limited to transportation, disability, physical or emotional support. The simple Boolean indicator is a high level SDOH measure, with minimal burden for charting , flagging if the patient has additional challenges for receiving care. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTCourse_PatientHelperBrought</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0100130</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optional</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Boolean</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

<owl:Class rdf:about="RTCourse_DistanceToPatientPrimaryResidenceDirect">
  <rdfs:subClassOf rdf:resource="RTCourse"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distance To Patient Primary Residence Direct</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Direct Distance from the patient’s primary residence to the facility where the radiation therapy course is delivered. Direct distance may be less than driving distance. Provides a PHI neutral measure of accessibility. </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTCourse_DistanceToPatientPrimaryResidenceDirect</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0100140</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optional</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Numeric</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">34.5</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

<owl:Class rdf:about="RTCourse_DistanceToPatientPrimaryResidenceDirectMethod">
  <rdfs:subClassOf rdf:resource="RTCourse"/>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distance To Patient Primary Residence Direct Method</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">There are several levels of granularity for specifying direct distance between two points. Address and GPS provide the most specific values. More general, average, distances may be calculated based on postal code, city (or town) county, province, state, or country </rdfs:comment>
  <ValueType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attribute</ValueType>
  <StringCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RTCourse_DistanceToPatientPrimaryResidenceDirectMethod</StringCode>
  <NumericCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O3_0100150</NumericCode>
  <ValuePriority rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optional</ValuePriority>
  <MoreThanOneValueAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No</MoreThanOneValueAllowed>
  <ValueDataType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">String</ValueDataType>
  <StandardValuesUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></StandardValuesUse>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Postal Code {O3_0100150_00006}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(+Other) {O3_0100150_00009}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">City {O3_0100150_00005}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">State {O3_0100150_00002}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Address {O3_0100150_00007}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">County {O3_0100150_00004}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Country {O3_0100150_00001}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GPS {O3_0100150_00008}</StandardValuesList>
  <StandardValuesList rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Province {O3_0100150_00003}</StandardValuesList>
  <ReferenceSystemForValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></ReferenceSystemForValues>
  <AllowNullValues rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yes</AllowNullValues>
  <ValueExample rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Postal Code</ValueExample>
  <SCTID rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></SCTID>
  <NCITC rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCITC>
  <NCIMT rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></NCIMT>
</owl:Class>

